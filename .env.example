# Local development only. Never put real credentials in this file.
NODE_ENV=development
DATABASE_URL=postgresql://meridian:meridian@127.0.0.1:5432/meridian_dev
PORT=8080
PUBLIC_APP_URL=http://localhost:8080

# Development authentication and seed data. Keep disabled outside local work.
ENABLE_DEV_AUTH=true
SEED_DEMO=true
DEMO_PASSWORD=replace-with-a-local-only-password

# Generate long random values locally. Production uses the deployment secret store.
SESSION_SECRET=replace-with-at-least-32-random-characters
INBOUND_EMAIL_TOKEN=
INBOUND_WHATSAPP_TOKEN=
METRICS_TOKEN=
SWEEP_TOKEN=

# Clerk/model provider. Leave unset to keep model-backed features dark.
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=
CLERK_MODEL=

# Provider integrations. Unset means disabled/fail closed.
ERP_CONNECTOR_URL=
ERP_CONNECTOR_TOKEN=
BANK_FEED_URL=
BANK_FEED_TOKEN=
RAIL_PRIMARY_URL=
RAIL_PRIMARY_TOKEN=
RAIL_SECONDARY_URL=
RAIL_SECONDARY_TOKEN=

# Invoice Room must have both values before activation.
INVOICE_ROOM_ENCRYPTION_KEY=

# Browser bundles use checked-in defaults. Deployment workflows may override these.
BASE_PATH=/
FRAME_ANCESTORS="'self'"

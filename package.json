{
  "name": "workspace",
  "version": "0.0.0",
  "license": "UNLICENSED",
  "scripts": {
    "preinstall": "node ./scripts/ensure-pnpm.mjs",
    "build": "pnpm run typecheck && pnpm --filter @workspace/api-server --filter @workspace/landing --filter @workspace/console --filter @workspace/sme-compliance --filter @workspace/buyer-portal --filter @workspace/penalty-calculator run build",
    "build:mobile": "pnpm --filter @workspace/mobile run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "lint": "eslint .",
    "architecture:check": "pnpm --filter @workspace/scripts quality:architecture",
    "security:secrets": "pnpm --filter @workspace/scripts quality:secrets",
    "maintainability:report": "pnpm --filter @workspace/scripts quality:metrics",
    "complexity:report": "pnpm --filter @workspace/scripts quality:complexity report",
    "complexity:check": "pnpm --filter @workspace/scripts quality:complexity check",
    "complexity:write": "pnpm --filter @workspace/scripts quality:complexity write",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:check": "pnpm --filter @workspace/scripts quality:docs",
    "brand:check": "pnpm --filter @workspace/scripts quality:brand",
    "release:prepare": "node scripts/src/ops/release-candidate.mjs",
    "ops:check": "node scripts/src/ops/operational-check.mjs",
    "test:workspace-usability": "node --test --test-concurrency=1 lib/web-ui/src/first-invoice.browser.test.mjs lib/web-ui/src/business-details.browser.test.mjs scripts/src/e2e/workspace-usability.test.mjs scripts/src/e2e/workspace-usability-hooks.test.mjs scripts/src/e2e/workspace-team-work.test.mjs scripts/src/e2e/workspace-created-task.test.mjs",
    "test:unit": "pnpm --filter @workspace/api-errors --filter @workspace/format --filter @workspace/web-config --filter @workspace/web-ui --filter @workspace/mobile --filter @workspace/landing --filter @workspace/console --filter @workspace/sme-compliance --filter @workspace/buyer-portal --filter @workspace/penalty-calculator run test && pnpm --filter @workspace/api-server run test:pure",
    "check": "pnpm run architecture:check && pnpm run security:secrets && pnpm run docs:check && pnpm run brand:check && pnpm run complexity:check && pnpm run format:check && pnpm run typecheck && pnpm run lint && pnpm run test:unit"
  },
  "engines": {
    "node": ">=22 <25",
    "pnpm": ">=10.26 <12"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.7.0",
    "prettier": "^3.8.4",
    "tsx": "catalog:",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.63.0"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.18": ">=8.5.18",
      "xcode>uuid": ">=11.1.1",
      "brace-expansion@<5.0.9": ">=5.0.9",
      "tar@<7.5.21": ">=7.5.21",
      "js-yaml@>=4.0.0 <4.3.2": ">=4.3.2 <5.0.0",

modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["github:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[nix]
channel = "stable-25_05"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 18115
externalPort = 3001

[[ports]]
localPort = 21831
externalPort = 3003

[[ports]]
localPort = 23876
externalPort = 3000

[[ports]]
localPort = 24917
externalPort = 3002

[[ports]]
localPort = 25883
externalPort = 80

[[ports]]
localPort = 26060
externalPort = 4200

[userenv]

[userenv.development]
SEED_DEMO = "true"
